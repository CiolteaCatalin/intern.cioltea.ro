Options -Indexes

<FilesMatch "^(config\.php|config\.example\.php|database\.sql|README.*|.*\.log|vapid-.*|composer\.(json|lock)|\.env.*)$">
  Require all denied
</FilesMatch>

<Files "install.php">
  Require all denied
</Files>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(self), microphone=(), geolocation=(), payment=(), usb=()"
</IfModule>

# Static assets are versioned in HTML, so a short immutable-ish cache is safe.
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|svg|png|jpg|jpeg|webp|ico)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=86400"
  </FilesMatch>
</IfModule>
